{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "cinemaX/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "cinemaX/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/cinemaX/dist/index.html"
    }
  ]
}
